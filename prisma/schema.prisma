// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  // binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id
  uniqueId      String?  @unique
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  sessions                  Session[]
  accounts                  Account[]
  announcements             Announcement[]
  leaves                    Leave[]
  timerSessions             TimerSession[]
  timesheets                Timesheet[]
  announcementNotifications AnnouncementNotification[] @relation("announcementNotifications")
  checkInOutNotifications   CheckInOutNotification[]   @relation("CheckInOutNotifications")
  leaveNotifications        LeaveNotification[]        @relation("LeaveNotifications")
  projects                  Project[]                  @relation("ProjectMembers")

  phone              String?
  role               String?
  salary             Int?
  address            String?
  departmentId       String?
  department         Department? @relation("DepartmentEmployees", fields: [departmentId], references: [id], onDelete: SetNull)
  isPasswordChanged  Boolean     @default(true)
  isProfileCompleted Boolean     @default(false)
  githubUrl          String?
  linkedinUrl        String?

  // Onboarding relations
  profile     Profile?
  experiences UserExperience[]
  educations  UserEducation[]
  skills      UserSkill[]

  // Activity Tracking
  activityLogs ActivityLog[]

  // Shift Management
  userShifts UserShift[]

  // Leave Balances
  leaveBalances LeaveBalance[]

  // Overtime Records
  overtimeRecords OvertimeRecord[]

  // Attendance Deviations
  attendanceDeviations AttendanceDeviation[]

  // Attendance Regularization
  regularizations         AttendanceRegularization[]
  approvedRegularizations AttendanceRegularization[] @relation("RegularizationApprover")

  // Timesheet Submissions
  timesheetSubmissions         TimesheetSubmission[] @relation("TimesheetSubmissions")
  approvedTimesheetSubmissions TimesheetSubmission[] @relation("TimesheetApprover")

  // Performance Reviews
  reviewsAsEmployee Review[] @relation("ReviewEmployee")
  reviewsAsReviewer  Review[] @relation("Reviewer")

  // Assets
  assetAssignments AssetAssignment[]

  // Standups
  standupReports StandupReport[]

  // Feedback
  feedbacks Feedback[]

  // Chat
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]

  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  // Manager hierarchy (Org Chart)
  managerId    String?
  manager      User?   @relation("ManagerReports", fields: [managerId], references: [id])
  directReports User[] @relation("ManagerReports")

  // Milestone dates
  dateOfBirth DateTime?
  joinDate    DateTime?

  // New feature relations
  pomodoroSessions        PomodoroSession[]
  pomodoroSettings        PomodoroSettings?
  shiftScheduleEntries    ShiftScheduleEntry[]
  shiftSwapRequestsSent   ShiftSwapRequest[]   @relation("SwapRequester")
  shiftSwapRequestsTarget ShiftSwapRequest[]   @relation("SwapTarget")
  shiftSwapReviews        ShiftSwapRequest[]   @relation("SwapReviewer")
  availability            EmployeeAvailability[]
  bonusCommissions        BonusCommission[]
  approvedCompensations   BonusCommission[]    @relation("CompensationApprover")
  expenses                Expense[]
  approvedExpenses        Expense[]            @relation("ExpenseApprover")
  offboardingProcesses    OffboardingProcess[] @relation("OffboardingEmployee")
  initiatedOffboardings   OffboardingProcess[] @relation("OffboardingInitiator")
  offboardingTasksAssigned OffboardingTask[]   @relation("OffboardingTaskAssignee")
  offboardingTasksCompleted OffboardingTask[]  @relation("OffboardingTaskCompleter")
  uploadedDocuments       Document[]
  documentAcknowledgments DocumentAcknowledgment[]
  milestoneEvents         MilestoneEvent[]
  gamificationPoints      GamificationPoints[]
  userBadges              UserBadge[]
  wellnessChallengesCreated WellnessChallenge[]
  wellnessParticipations  WellnessChallengeParticipant[]
  moodEntries             MoodEntry[]
  configuratedIntegrations Integration[]
  locationLogs            LocationLog[]
  scheduledReports        ScheduledReport[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Announcement {
  id           String               @id @default(uuid())
  title        String
  description  String
  category     AnnouncementCategory
  departmentId String?
  department   Department?          @relation("DepartmentAnnouncements", fields: [departmentId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  // Track which employees have seen this announcement
  notifications AnnouncementNotification[]

  @@map("announcements")
}

model AnnouncementNotification {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  employeeId String
  employee   User   @relation("announcementNotifications", fields: [employeeId], references: [id], onDelete: Cascade)

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@unique([announcementId, employeeId])
  @@index([employeeId])
  @@index([announcementId])
  @@map("announcement_notifications")
}

model LeaveNotification {
  id      String @id @default(uuid())
  leaveId String
  leave   Leave  @relation(fields: [leaveId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("LeaveNotifications", fields: [userId], references: [id], onDelete: Cascade)

  type      LeaveNotificationType
  message   String
  isRead    Boolean               @default(false)
  readAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([userId])
  @@index([leaveId])
  @@map("leave_notifications")
}

enum LeaveNotificationType {
  LEAVE_APPLIED
  LEAVE_APPROVED
  LEAVE_REJECTED
}

model Leave {
  id         String @id @default(uuid())
  employeeId String
  employee   User   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveType LeaveType
  startDate DateTime
  endDate   DateTime
  duration  Int
  reason    String?

  prescriptionUrl String?

  status        LeaveStatus @default(PENDING)
  approvalNotes String?
  approvalDate  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Track which users have been notified about this leave
  notifications LeaveNotification[]

  @@map("leaves")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum AnnouncementCategory {
  holiday
  update
  urgent
  birthday
  policy
}

enum LeaveType {
  ANNUAL_LEAVE
  MATERNITY_LEAVE
  CASUAL_LEAVE
  SICK_LEAVE
  PERSONAL_LEAVE
  UNPAID_LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

model Department {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  // Relationships
  employees     User[]         @relation("DepartmentEmployees")
  announcements Announcement[] @relation("DepartmentAnnouncements")
  projects      Project[]      @relation("ProjectDepartment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)

  // Department association
  departmentId String?
  department   Department? @relation("ProjectDepartment", fields: [departmentId], references: [id], onDelete: SetNull)

  // Team members
  members User[] @relation("ProjectMembers")

  // Track hours - total hours worked across all users
  totalHoursWorked Float @default(0)

  // Track timer sessions for reference
  timerSessions TimerSession[] @relation("ProjectTimerSessions")
  timesheets       Timesheet[]      @relation("ProjectTimesheets")
  timesheetEntries TimesheetEntry[] @relation("TimesheetEntryProject")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([status])
  @@map("projects")
}

model TimerSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation("ProjectTimerSessions", fields: [projectId], references: [id], onDelete: SetNull)

  startTime             DateTime
  lastProjectSwitchTime DateTime? // Track when last project switch occurred
  endTime               DateTime?
  totalDuration         Int? // Total seconds worked
  isActive              Boolean   @default(true)

  status   String    @default("checked_in") // checked_in, paused, checked_out
  isPaused Boolean   @default(false)
  pausedAt DateTime?

  // GPS Location
  checkInLatitude   Float?
  checkInLongitude  Float?
  checkInAddress    String?
  checkOutLatitude  Float?
  checkOutLongitude Float?
  checkOutAddress   String?

  pauseLogs    PauseLog[]
  activityLogs ActivityLog[]
  deviations   AttendanceDeviation[]
  locationLogs LocationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([isActive])
}

model ActivityLog {
  id String @id @default(uuid())

  timerSessionId String
  timerSession   TimerSession @relation(fields: [timerSessionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  timestamp DateTime

  // Activity Metrics
  keyboardCount Int     @default(0)
  mouseDistance Int     @default(0)
  clickCount    Int     @default(0)
  isIdle        Boolean @default(false)

  // Context
  windowTitle String?
  appName     String?
  url         String?

  createdAt DateTime @default(now())

  @@index([timerSessionId])
  @@index([userId])
  @@map("activity_logs")
}

model PauseLog {
  id             String       @id @default(uuid())
  timerSessionId String
  timerSession   TimerSession @relation(fields: [timerSessionId], references: [id], onDelete: Cascade)

  pausedAt  DateTime
  resumedAt DateTime?
  duration  Int? // Duration in seconds

  createdAt DateTime @default(now())

  @@index([timerSessionId])
}

model Timesheet {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation("ProjectTimesheets", fields: [projectId], references: [id], onDelete: SetNull)

  workDate       DateTime  @db.Date
  checkInTime    DateTime
  checkOutTime   DateTime?
  totalHours     Float? // Total hours worked (excluding pauses)
  totalPauseTime Int? // Total pause duration in seconds

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, workDate])
  @@index([userId])
  @@index([projectId])
  @@index([workDate])
}

// Weekly Timesheet Submissions
model TimesheetSubmission {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation("TimesheetSubmissions", fields: [userId], references: [id], onDelete: Cascade)
  weekStart   DateTime       @db.Date
  weekEnd     DateTime       @db.Date
  totalHours  Float
  status      ApprovalStatus @default(PENDING)
  submittedAt DateTime       @default(now())
  approvedBy  String?
  approver    User?          @relation("TimesheetApprover", fields: [approvedBy], references: [id])
  approvedAt  DateTime?
  adminNote   String?
  entries     TimesheetEntry[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([userId, weekStart])
  @@index([userId])
  @@index([status])
  @@map("timesheet_submissions")
}

model TimesheetEntry {
  id           String              @id @default(cuid())
  submissionId String
  submission   TimesheetSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  date         DateTime            @db.Date
  projectId    String?
  project      Project?            @relation("TimesheetEntryProject", fields: [projectId], references: [id], onDelete: SetNull)
  hours        Float
  description  String?
  createdAt    DateTime            @default(now())

  @@index([submissionId])
  @@index([projectId])
  @@map("timesheet_entries")
}

model ImportantLink {
  id        String   @id @default(uuid())
  title     String
  url       String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("important_links")
}

model TermsCondition {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("terms_conditions")
}

// Onboarding related models
model Profile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  about     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("profiles")
}

model UserExperience {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  position    String
  company     String
  startDate   DateTime
  endDate     DateTime?
  description String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_experiences")
}

model UserEducation {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  educationName String
  institute     String
  startDate     DateTime
  endDate       DateTime?
  description   String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_educations")
}

model UserSkill {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  skillName String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("user_skills")
}

// Shift Management
model Shift {
  id           String      @id @default(cuid())
  name         String      // "Morning Shift", "Night Shift"
  startTime    String      // "09:00" (HH:mm format)
  endTime      String      // "18:00"
  graceMinutes Int         @default(15)
  breakMinutes Int         @default(60)
  isDefault    Boolean     @default(false)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  employees    UserShift[]
  scheduleEntries ShiftScheduleEntry[]

  @@map("shifts")
}

model UserShift {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId   String
  shift     Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  createdAt DateTime  @default(now())

  @@unique([userId, shiftId, startDate])
  @@index([userId])
  @@index([shiftId])
  @@map("user_shifts")
}

// Leave Balance Management
model LeaveBalance {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType   LeaveType
  year        Int
  totalDays   Float     // Allocated days for the year
  usedDays    Float     @default(0)
  carriedOver Float     @default(0) // From previous year
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, leaveType, year])
  @@index([userId])
  @@index([year])
  @@map("leave_balances")
}

model LeavePolicy {
  id            String    @id @default(cuid())
  leaveType     LeaveType @unique
  annualDays    Float     // Default days per year
  maxCarryOver  Float     @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("leave_policies")
}

// Late/Early Departure Tracking
model AttendanceDeviation {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime     @db.Date
  timerSessionId  String
  timerSession    TimerSession @relation(fields: [timerSessionId], references: [id], onDelete: Cascade)
  expectedStart   DateTime
  actualStart     DateTime
  expectedEnd     DateTime
  actualEnd       DateTime?
  lateMinutes     Int          @default(0)
  earlyMinutes    Int          @default(0)
  isExcused       Boolean      @default(false)
  excuseReason    String?
  createdAt       DateTime     @default(now())

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("attendance_deviations")
}

// Attendance Regularization
model AttendanceRegularization {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime           @db.Date
  type          RegularizationType
  requestedTime DateTime
  reason        String
  status        ApprovalStatus     @default(PENDING)
  approvedBy    String?
  approver      User?              @relation("RegularizationApprover", fields: [approvedBy], references: [id])
  adminNote     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([userId])
  @@index([date])
  @@index([status])
  @@map("attendance_regularizations")
}

enum RegularizationType {
  MISSED_CHECKIN
  MISSED_CHECKOUT
  WRONG_TIME
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// Overtime Tracking
model OvertimeConfig {
  id                String   @id @default(cuid())
  dailyLimitHours   Float    @default(9)
  weeklyLimitHours  Float    @default(45)
  monthlyLimitHours Float    @default(180)
  alertThreshold    Float    @default(0.9) // Alert at 90% of limit
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("overtime_configs")
}

model OvertimeRecord {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  regularHours  Float
  overtimeHours Float
  totalHours    Float
  createdAt     DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("overtime_records")
}

model CheckInOutNotification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("CheckInOutNotifications", fields: [userId], references: [id], onDelete: Cascade)

  type String // "check_in" or "check_out"
  time DateTime // Time when user checked in/out

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@map("check_in_out_notifications")
}

// App Usage Categorization (for Reports)
model AppCategory {
  id        String             @id @default(cuid())
  appName   String             @unique
  category  ProductivityCategory
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@map("app_categories")
}

enum ProductivityCategory {
  PRODUCTIVE
  NEUTRAL
  UNPRODUCTIVE
  UNCATEGORIZED
}

// Performance Reviews
model ReviewCycle {
  id        String            @id @default(cuid())
  name      String
  startDate DateTime          @db.Date
  endDate   DateTime          @db.Date
  status    ReviewCycleStatus @default(DRAFT)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  reviews   Review[]

  @@map("review_cycles")
}

enum ReviewCycleStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

model Review {
  id            String       @id @default(cuid())
  cycleId       String
  cycle         ReviewCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      User         @relation("ReviewEmployee", fields: [employeeId], references: [id])
  reviewerId    String
  reviewer      User         @relation("Reviewer", fields: [reviewerId], references: [id])
  overallRating Float?
  strengths     String?
  improvements  String?
  comments      String?
  status        ReviewStatus @default(PENDING)
  submittedAt   DateTime?
  goals         ReviewGoal[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([cycleId])
  @@index([employeeId])
  @@index([reviewerId])
  @@map("reviews")
}

enum ReviewStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  ACKNOWLEDGED
}

model ReviewGoal {
  id          String   @id @default(cuid())
  reviewId    String
  review      Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  title       String
  description String?
  rating      Float?
  weight      Float    @default(1)
  createdAt   DateTime @default(now())

  @@index([reviewId])
  @@map("review_goals")
}

// Asset Tracking
model Asset {
  id           String            @id @default(cuid())
  name         String
  type         AssetType
  serialNumber String?           @unique
  purchaseDate DateTime?         @db.Date
  purchaseCost Float?
  condition    AssetCondition    @default(GOOD)
  notes        String?
  isAvailable  Boolean           @default(true)
  assignments  AssetAssignment[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("assets")
}

enum AssetType {
  LAPTOP
  MONITOR
  KEYBOARD
  MOUSE
  HEADSET
  PHONE
  TABLET
  FURNITURE
  SOFTWARE_LICENSE
  OTHER
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
  RETIRED
}

model AssetAssignment {
  id         String    @id @default(cuid())
  assetId    String
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  assignedAt DateTime  @default(now())
  returnedAt DateTime?
  notes      String?

  @@index([assetId])
  @@index([userId])
  @@map("asset_assignments")
}

// Daily Standup Reports
model StandupReport {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  yesterday String
  today     String
  blockers  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("standup_reports")
}

// Feedback & Suggestions
model Feedback {
  id          String           @id @default(cuid())
  userId      String?
  user        User?            @relation(fields: [userId], references: [id])
  category    FeedbackCategory
  title       String
  message     String
  isAnonymous Boolean          @default(false)
  status      FeedbackStatus   @default(NEW)
  adminReply  String?
  repliedBy   String?
  repliedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@map("feedback")
}

enum FeedbackCategory {
  SUGGESTION
  COMPLAINT
  APPRECIATION
  BUG_REPORT
  OTHER
}

enum FeedbackStatus {
  NEW
  REVIEWED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// Chat / Messaging
model Conversation {
  id           String                    @id @default(cuid())
  type         ConversationType          @default(DIRECT)
  name         String?
  participants ConversationParticipant[]
  messages     Message[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@map("conversations")
}

enum ConversationType {
  DIRECT
  GROUP
}

model ConversationParticipant {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  createdAt      DateTime      @default(now())

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  isEdited       Boolean      @default(false)
  editedAt       DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

// Team Calendar — Holidays
model Holiday {
  id         String   @id @default(cuid())
  name       String
  date       DateTime @db.Date
  isOptional Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("holidays")
}

// ============================================
// NEW FEATURES — Phase 1 Schema Additions
// ============================================

// Feature 1: GPS Location Tracking
model LocationLog {
  id             String       @id @default(cuid())
  timerSessionId String
  timerSession   TimerSession @relation(fields: [timerSessionId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude       Float
  longitude      Float
  accuracy       Float?
  address        String?
  timestamp      DateTime     @default(now())

  @@index([timerSessionId])
  @@index([userId])
  @@index([timestamp])
  @@map("location_logs")
}

// Feature 2: Pomodoro Timer
model PomodoroSession {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskDescription   String?
  focusDuration     Int      @default(25) // minutes
  breakDuration     Int      @default(5)
  longBreakDuration Int      @default(15)
  totalRounds       Int      @default(4)
  completedRounds   Int      @default(0)
  totalFocusMinutes Int      @default(0)
  status            PomodoroStatus @default(COMPLETED)
  startedAt         DateTime @default(now())
  endedAt           DateTime?
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("pomodoro_sessions")
}

enum PomodoroStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model PomodoroSettings {
  id                String @id @default(cuid())
  userId            String @unique
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  focusDuration     Int    @default(25)
  breakDuration     Int    @default(5)
  longBreakDuration Int    @default(15)
  roundsBeforeLongBreak Int @default(4)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("pomodoro_settings")
}

// Feature 3: Shift Schedule Entries
model ShiftScheduleEntry {
  id         String   @id @default(cuid())
  employeeId String
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId    String
  shift      Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  startTime  String   // "09:00"
  endTime    String   // "18:00"
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, date, shiftId])
  @@index([employeeId])
  @@index([shiftId])
  @@index([date])
  @@map("shift_schedule_entries")
}

// Feature 4: Shift Swap Requests
model ShiftSwapRequest {
  id                    String             @id @default(cuid())
  requesterId           String
  requester             User               @relation("SwapRequester", fields: [requesterId], references: [id])
  requesterScheduleId   String
  targetEmployeeId      String
  targetEmployee        User               @relation("SwapTarget", fields: [targetEmployeeId], references: [id])
  targetScheduleId      String
  status                ApprovalStatus     @default(PENDING)
  reason                String?
  adminNote             String?
  reviewedBy            String?
  reviewer              User?              @relation("SwapReviewer", fields: [reviewedBy], references: [id])
  reviewedAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([requesterId])
  @@index([targetEmployeeId])
  @@index([status])
  @@map("shift_swap_requests")
}

// Feature 7: Shift Settings
model ShiftSettings {
  id                  String   @id @default(cuid())
  minRestPeriodHours  Float    @default(11)
  maxShiftHours       Float    @default(12)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("shift_settings")
}

// Feature 6: Employee Availability
model EmployeeAvailability {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek   Int      // 0=Sunday, 6=Saturday
  startTime   String   // "09:00"
  endTime     String   // "17:00"
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, dayOfWeek])
  @@index([userId])
  @@map("employee_availability")
}

// Feature 8: Bonus & Commission Tracking
model BonusCommission {
  id          String                @id @default(cuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        CompensationType
  category    CompensationCategory
  amount      Float
  currency    String                @default("USD")
  description String?
  status      CompensationStatus    @default(PENDING)
  approvedBy  String?
  approver    User?                 @relation("CompensationApprover", fields: [approvedBy], references: [id])
  approvedAt  DateTime?
  paidAt      DateTime?
  payPeriod   String?               // "2026-01" format
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
  @@map("bonus_commissions")
}

enum CompensationType {
  BONUS
  COMMISSION
}

enum CompensationCategory {
  PERFORMANCE
  REFERRAL
  HOLIDAY
  SALES
  RETENTION
  SIGNING
  OTHER_COMPENSATION
}

enum CompensationStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

// Feature 9: Expense Management
model Expense {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  amount          Float
  currency        String        @default("USD")
  category        ExpenseCategory
  receiptUrl      String?
  receiptFileName String?
  status          ExpenseStatus @default(SUBMITTED)
  rejectionReason String?
  approvedBy      String?
  approver        User?         @relation("ExpenseApprover", fields: [approvedBy], references: [id])
  approvedAt      DateTime?
  reimbursedAt    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@map("expenses")
}

enum ExpenseCategory {
  TRAVEL
  MEALS
  EQUIPMENT
  SOFTWARE
  OFFICE_SUPPLIES
  TRAINING
  OTHER_EXPENSE
}

enum ExpenseStatus {
  SUBMITTED
  APPROVED
  REJECTED
  REIMBURSED
}

// Feature 10: Offboarding Workflows
model OffboardingProcess {
  id              String              @id @default(cuid())
  employeeId      String
  employee        User                @relation("OffboardingEmployee", fields: [employeeId], references: [id])
  initiatedBy     String
  initiator       User                @relation("OffboardingInitiator", fields: [initiatedBy], references: [id])
  status          OffboardingStatus   @default(IN_PROGRESS)
  lastWorkingDate DateTime            @db.Date
  completedAt     DateTime?
  tasks           OffboardingTask[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([employeeId])
  @@index([status])
  @@map("offboarding_processes")
}

enum OffboardingStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model OffboardingTask {
  id          String                 @id @default(cuid())
  processId   String
  process     OffboardingProcess     @relation(fields: [processId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    OffboardingCategory
  assignedTo  String?
  assignee    User?                  @relation("OffboardingTaskAssignee", fields: [assignedTo], references: [id])
  status      OffboardingTaskStatus  @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?
  completedBy String?
  completer   User?                  @relation("OffboardingTaskCompleter", fields: [completedBy], references: [id])
  notes       String?
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([processId])
  @@index([assignedTo])
  @@map("offboarding_tasks")
}

enum OffboardingCategory {
  IT_ACCESS
  EQUIPMENT
  KNOWLEDGE_TRANSFER
  EXIT_INTERVIEW
  DOCUMENTATION
  FINAL_PAY
}

enum OffboardingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// Feature 12: Document Management
model Document {
  id                      String                  @id @default(cuid())
  title                   String
  description             String?
  category                DocumentCategory
  filePath                String
  fileName                String
  fileSize                Int
  mimeType                String
  version                 Int                     @default(1)
  requiresAcknowledgment  Boolean                 @default(false)
  uploadedBy              String
  uploader                User                    @relation(fields: [uploadedBy], references: [id])
  isActive                Boolean                 @default(true)
  acknowledgments         DocumentAcknowledgment[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([category])
  @@index([uploadedBy])
  @@map("documents")
}

enum DocumentCategory {
  CONTRACT
  POLICY
  HANDBOOK
  NDA
  OTHER_DOCUMENT
}

model DocumentAcknowledgment {
  id             String   @id @default(cuid())
  documentId     String
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  acknowledgedAt DateTime @default(now())

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
  @@map("document_acknowledgments")
}

// Feature 13: Birthday & Work Anniversary
model MilestoneEvent {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           MilestoneType
  eventDate      DateTime      @db.Date
  year           Int
  announcementId String?
  createdAt      DateTime      @default(now())

  @@unique([userId, type, year])
  @@index([eventDate])
  @@map("milestone_events")
}

enum MilestoneType {
  BIRTHDAY
  WORK_ANNIVERSARY
}

// Feature 14: Gamification
model GamificationPoints {
  id       String                  @id @default(cuid())
  userId   String
  user     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  points   Int
  reason   String
  category GamificationCategory
  earnedAt DateTime                @default(now())

  @@index([userId])
  @@index([earnedAt])
  @@map("gamification_points")
}

enum GamificationCategory {
  ATTENDANCE
  PRODUCTIVITY
  RECOGNITION
  TRAINING
  WELLNESS
}

model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  icon        String      // emoji or icon name
  criteria    String      // human-readable criteria
  threshold   Int         @default(0) // points needed
  userBadges  UserBadge[]
  createdAt   DateTime    @default(now())

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

// Feature 15: Wellness Challenges
model WellnessChallenge {
  id           String                         @id @default(cuid())
  title        String
  description  String?
  type         WellnessChallengeType
  startDate    DateTime                       @db.Date
  endDate      DateTime                       @db.Date
  goal         Float                          // target number
  unit         String                         // "steps", "minutes", "glasses", etc.
  createdBy    String
  creator      User                           @relation(fields: [createdBy], references: [id])
  isActive     Boolean                        @default(true)
  participants WellnessChallengeParticipant[]
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @updatedAt

  @@index([isActive])
  @@map("wellness_challenges")
}

enum WellnessChallengeType {
  STEPS
  MINDFULNESS
  HYDRATION
  EXERCISE
  CUSTOM
}

model WellnessChallengeParticipant {
  id          String            @id @default(cuid())
  challengeId String
  challenge   WellnessChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress    Float             @default(0)
  completedAt DateTime?
  joinedAt    DateTime          @default(now())

  @@unique([challengeId, userId])
  @@index([challengeId])
  @@index([userId])
  @@map("wellness_challenge_participants")
}

// Feature 16: Mood Tracking
model MoodEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood      Int      // 1-5 scale
  note      String?
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("mood_entries")
}

// Feature 17: Integrations (Slack, Teams, Google Calendar, Jira, ClickUp)
model Integration {
  id           String          @id @default(cuid())
  type         IntegrationType
  name         String?
  webhookUrl   String?
  accessToken  String?
  refreshToken String?
  channelId    String?
  domain       String?         // for Jira: "company.atlassian.net"
  projectMapping String?       @db.Text // JSON mapping of Forrof projects to external projects
  isActive     Boolean         @default(true)
  configuredBy String
  configurer   User            @relation(fields: [configuredBy], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([type])
  @@map("integrations")
}

enum IntegrationType {
  SLACK
  TEAMS
  GOOGLE_CALENDAR
  JIRA
  CLICKUP
}

// Feature 24: Scheduled Report Delivery
model ScheduledReport {
  id         String              @id @default(cuid())
  name       String
  reportType ScheduledReportType
  frequency  ReportFrequency
  recipients String[]            // array of email addresses
  filters    String?             @db.Text // JSON filters
  lastSentAt DateTime?
  nextSendAt DateTime?
  isActive   Boolean             @default(true)
  createdBy  String
  creator    User                @relation(fields: [createdBy], references: [id])
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([isActive])
  @@map("scheduled_reports")
}

enum ScheduledReportType {
  ATTENDANCE
  OVERTIME
  LEAVE
  PRODUCTIVITY
  COST
}

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}
